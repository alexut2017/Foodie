{
  "expo": {
    "name": "GrubScout",
    "slug": "grubscout",
    "version": "0.1.0",
    "scheme": "grubscout",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F4EF",
    "ios": {
      "bundleIdentifier": "com.grubscout.app",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "GrubScout uses your location to show partner restaurants near you.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.grubscout.app",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "adaptiveIcon": { "backgroundColor": "#E2552B" }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-location",
        { "locationWhenInUsePermission": "GrubScout uses your location to show partner restaurants near you." }
      ]
    ],
    "experiments": { "typedRoutes": false },
    "extra": {
      "supabaseUrl": "https://mroiimqqklitidpzaqnk.supabase.co",
      "supabasePublishableKey": "sb_publishable_1YSf5nmBBotBnOULa3g7vQ_nj0Fd1RH",
      "siteUrl": "https://wuemilyy-stack.github.io/Foodie/",
      "termsVersion": "2026-10-25",
      "appleSignIn": false
    }
  }
}
